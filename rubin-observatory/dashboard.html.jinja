<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ project.title }} &mdash; {{ org.title }}</title>
<meta name="generator" content="docverse {{ docverse.version }}">
<meta name="docverse:rendered-at" content="{{ rendered_at.isoformat() }}">
{% set favicon = assets.images.get('rubin_favicon_transparent_32px_png') %}
{% if favicon %}<link rel="icon" type="image/png" href="{{ favicon }}">{% endif %}
{# Source Sans 3 variable font (upright and italic, weights 200-900) from Google Fonts #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
{% if assets.css %}<style>{{ assets.css|safe }}</style>{% endif %}
</head>
<body>
<header class="site-header">
  {% set logo = assets.images.get('rubin_imagotype_color_on_white_crop_svg') %}
  {% if logo %}<span class="logo">{{ logo|safe }}</span>{% endif %}
  <div class="site-header__text">
    <p class="kicker">Documentation editions</p>
    <h1>{{ project.title }}</h1>
  </div>
</header>

<main>
{# One edition entry: linked title plus a muted "updated" timestamp.
   The server renders an ISO date; dashboard.js humanizes it ("2 hours ago")
   and the full ISO 8601 timestamp is shown on hover via the title attribute. #}
{% macro edition_item(edition) -%}
    <li><a href="{{ edition.published_url }}">{{ edition.title }}</a>
      {%- set iso = edition.date_updated.isoformat() %}
      <time class="updated" datetime="{{ iso }}" title="{{ iso }}">{{ edition.date_updated.strftime('%Y-%m-%d') }}</time></li>
{%- endmacro %}
{% if editions.main or editions.alternates %}
<section id="main-edition">
  <h2>Current</h2>
  <ul>
  {% if editions.main %}
    {{ edition_item(editions.main) }}
  {% endif %}
  {% for edition in editions.alternates %}
    {{ edition_item(edition) }}
  {% endfor %}
  </ul>
</section>
{% endif %}

{% if editions.releases %}
<section id="releases">
  <h2>Releases</h2>
  <ul>
  {% for edition in editions.releases %}
    {{ edition_item(edition) }}
  {% endfor %}
  </ul>
</section>
{% endif %}

{% if editions.major %}
<section id="major-versions">
  <h2>Major versions</h2>
  <ul>
  {% for edition in editions.major %}
    {{ edition_item(edition) }}
  {% endfor %}
  </ul>
</section>
{% endif %}

{% if editions.minor %}
<section id="minor-versions">
  <h2>Minor versions</h2>
  <ul>
  {% for edition in editions.minor %}
    {{ edition_item(edition) }}
  {% endfor %}
  </ul>
</section>
{% endif %}

{% if editions.drafts %}
<section id="drafts">
  <h2>Drafts</h2>
  <ul>
  {% for edition in editions.drafts %}
    {{ edition_item(edition) }}
  {% endfor %}
  </ul>
</section>
{% endif %}
</main>

<footer class="site-footer">
  <p>Hosted by <a href="https://github.com/lsst-sqre/docverse">Docverse</a> for {{ org.title }}.</p>
</footer>

{% if assets.js %}<script>{{ assets.js|safe }}</script>{% endif %}
</body>
</html>
